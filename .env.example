# Copy to .env and change if needed. .env is never committed.

# Where the SQLite test database lives (relative to the project folder).
DATABASE_PATH=data/expert_register.db

# Secret key for the one-time login codes (HMAC-SHA256). At least 32 characters.
# The app refuses to start while it is empty. Make one with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
CODE_KEY=

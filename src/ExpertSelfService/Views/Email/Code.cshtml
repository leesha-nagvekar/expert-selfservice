@model EmailCodePage
@{
    ViewData["Title"] = Text["email.code.title"];
}
<h1>@Text["email.code.title"]</h1>
<p>@string.Format(System.Globalization.CultureInfo.CurrentCulture, Text["email.code.sent"], Model.NewEmail)</p>

<form method="post" action="/profile/email/code" novalidate>
  @Html.AntiForgeryToken()
  <div class="field">
    <label for="code">@Text["login.code.label"]</label>
    <p class="hint" id="code-hint">@string.Format(System.Globalization.CultureInfo.CurrentCulture, Text["login.code.hint"], OneTimeCodes.CodeLifetime.TotalMinutes)</p>
    @if (Model.Error is null)
    {
      <input id="code" name="Code" class="code" type="text" inputmode="numeric" autocomplete="one-time-code"
             aria-describedby="code-hint">
    }
    else
    {
      <input id="code" name="Code" class="code" type="text" inputmode="numeric" autocomplete="one-time-code"
             aria-invalid="true" aria-describedby="code-hint code-error">
      <p class="field-error" id="code-error">@Model.Error</p>
    }
  </div>
  <button type="submit">@Text["email.code.submit"]</button>
</form>

<p class="actions">
  <a href="/profile/email">@Text["login.start_over"]</a>
  @if (Model.ShowMailboxLink)
  {
    <a href="/dev/mailbox" target="_blank" rel="noopener">@Text["login.dev_mailbox"]</a>
  }
</p>

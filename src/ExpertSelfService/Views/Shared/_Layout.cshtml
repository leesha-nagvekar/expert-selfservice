@{
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // Switching language returns to the address the page names (LanguageLinks), else to the current one.
    // On an error page it goes to the front page.
    var page = ViewData[LanguageLinks.NextKey] as string
        ?? (Context.Request.Path.StartsWithSegments("/error")
            ? "/"
            : $"{Context.Request.Path}{Context.Request.QueryString}");
    var next = Uri.EscapeDataString(page);
    // Staff only: links to S-A and S-B, with the number of waiting changes (SPEC "The secretariat view").
    var isStaff = User.HasClaim(claim => claim.Type == SessionClaims.StaffId);
    // Routing ignores letter case and a trailing slash, so /Staff/ opens S-A too: compare the same way.
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/');
    bool IsPage(string href) => string.Equals(path, href, StringComparison.OrdinalIgnoreCase);
}
@inject PendingListService PendingList
<!doctype html>
<html lang="@language">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] ?? Text["app.name"])</title>
  <link rel="stylesheet" href="/tokens.css">
  <link rel="stylesheet" href="/fonts.css">
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  <header class="topbar">
    <a class="topbar-logo" href="/">
      <picture>
        <source media="(max-width: 479px)" srcset="/img/vn-mark-white.png">
        <img src="/img/vn-logo-white.png" alt="@Text["topbar.logo_alt"]">
      </picture>
    </a>
    @* Each label is written twice: label-long on wider screens, label-short with an icon on phones under 600 px
       (SPEC "The secretariat view"). CSS hides the other with display: none, so screen readers hear only one. *@
    @if (isStaff)
    {
      var pendingCount = PendingList.Count();
      <nav class="topbar-staff" aria-label="@Text["topbar.staff_nav"]">
        <a href="/staff" aria-current="@(IsPage("/staff") ? "page" : null)">@await Html.PartialAsync("_Icon", "search")<span class="label-long">@Text["staff.title"]</span><span class="label-short">@Text["topbar.search_short"]</span></a>
        <a href="/staff/pending" aria-current="@(IsPage("/staff/pending") ? "page" : null)">@await Html.PartialAsync("_Icon", "clock")<span class="label-long">@string.Format(CultureInfo.CurrentCulture, Text["topbar.pending"], pendingCount)</span><span class="label-short">@string.Format(CultureInfo.CurrentCulture, Text["topbar.pending_short"], pendingCount)</span></a>
      </nav>
    }
    <div class="topbar-actions">
      <nav class="topbar-language" aria-label="@Text["topbar.language"]">
        @if (language == "da")
        {
          <span aria-current="true" lang="da"><span class="label-long">@Text["language.da"]</span><span class="label-short">@Text["language.da_short"]</span></span>
          <span class="topbar-dot label-short" aria-hidden="true">·</span>
          <a href="/language/en?next=@next" lang="en"><span class="label-long">@Text["language.en"]</span><span class="label-short">@Text["language.en_short"]</span></a>
        }
        else
        {
          <a href="/language/da?next=@next" lang="da"><span class="label-long">@Text["language.da"]</span><span class="label-short">@Text["language.da_short"]</span></a>
          <span class="topbar-dot label-short" aria-hidden="true">·</span>
          <span aria-current="true" lang="en"><span class="label-long">@Text["language.en"]</span><span class="label-short">@Text["language.en_short"]</span></span>
        }
      </nav>
      @if (User.Identity?.IsAuthenticated == true)
      {
        @* On a phone only the icon shows; the label stays for screen readers (visually hidden, not display: none). *@
        <form class="topbar-logout" method="post" action="/logout">
          @Html.AntiForgeryToken()
          <button type="submit">@await Html.PartialAsync("_Icon", "logout")<span class="logout-label">@Text["topbar.logout"]</span></button>
        </form>
      }
    </div>
  </header>
  @* A page can ask for a wider column, such as the secretariat's search with its sidebar and table. *@
  <main class="@ViewData["MainClass"]">
    @RenderBody()
  </main>
  @await RenderSectionAsync("scripts", required: false)
</body>
</html>
